# UAT-oriented defaults (override for local-only: NODE_ENV=development, DATABASE_URL=localhost, etc.)
# Server Configuration
NODE_ENV="production"
PORT="6001"
# Url of the host where this app is running
# OCPI_HOST="https://nearly-boss-pheasant.ngrok-free.app"
# OCPI_HOST="http://localhost:6001"
# MOCK_BPP / registry: host + subscriber_id use "adapter" (not "adaptor")
OCPI_HOST=https://uat-bpp-opci-adapter.ubc.nbsl.org.in
# Database (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Can be left empty if you want to use docker DB
# DATABASE_URL="postgresql://username:password@host.docker.internal:5432/ubc_ocpi_adaptor?schema=public"
# DATABASE_URL="postgresql://postgres:root@localhost:5433/ocpi_adaptor_database"  # to run locally
DATABASE_URL="postgresql://postgres:postgres@ubc-postgres:5432/ubc_ocpi_adaptor"


# JWT Secret for Admin Authentication
# IMPORTANT: Generate a strong random string (min 32 characters)
# Use: openssl rand -base64 32
JWT_SECRET="your-secret-key-change-in-production-min-32-characters"
JWT_EXPIRES_IN="24h"
# CDS (UAT) — base for app config / direct calls; catalog_publish from adaptor goes via ONIX to …/cds/catalog_publish
# Official UAT URLs: https://uat-cds.ubc.nbsl.org.in/cds/discover, …/cds/on_discover, …/cds/catalog_publish, …/cds/actuator/health
ONIX_BPP_PLUGIN_URL="http://onix-bpp-plugin:8002"
# ONIX_BPP_PLUGIN_URL="https://uat-bpp-onix.ubc.nbsl.org.in"
CDS_BASE_URL="https://uat-cds.ubc.nbsl.org.in/cds"
CDS_API_KEY="your-cds-api-key"
# Logging Configuration
LOG_LEVEL="info"
CLOUD_PROVIDER="local"
# for UBC
# subscriber_id 
# MOCK_BPP subscriber_id — must match adapter.yaml networkParticipant / ONIX key lookup
EV_CHARGING_UBC_BPP_ID="uat-bpp-opci-adapter.ubc.nbsl.org.in"
# unique key_id
EV_CHARGING_UBC_UNIQUE_ID="76EU8AV7JusA4x7bLLTRLsiPJUmuFXgjoZggE3KV767ZKocKZX9WqH"
ONIX_BPP_SUBSCRIBER_ID="uat-bpp-opci-adapter.ubc.nbsl.org.in"
ONIX_BPP_KEY_ID="76EU8AV7JusA4x7bLLTRLsiPJUmuFXgjoZggE3KV767ZKocKZX9WqH"
# Public BPP base (catalog beckn:bppUri + catalog_publish context.bpp_uri = BPP_URL + "/bpp/receiver" for CDS → on_catalog_publish)
BPP_URL="https://uat-bpp-opci-adapter.ubc.nbsl.org.in"
# Optional: set only if the public ONIX /bpp/receiver host differs from BPP_URL (then publish_callback_url uses this + "/bpp/receiver")
# ONIX_BPP_PUBLIC_CALLBACK_URL=   
# BPP   # "http://localhost:7082"
EV_CHARGING_UBC_BPP_CLIENT_HOST="http://onix-bap-plugin:8001"                     
