PRIVATE_KEY="EQoV5BnFliUdoYvs1jvA+B0Y/Ae2EUvdMldUasLbqb0="
ONIX_BPP_SIGNING_PRIVATE_KEY="EQoV5BnFliUdoYvs1jvA+B0Y/Ae2EUvdMldUasLbqb0="
ONIX_BPP_SIGNING_PUBLIC_KEY="mmWTDIW17Hpmma/MS4tGhZZMb4DVBzj//zezIAJN+9k="
ONIX_REGISTRY_MODE="dedi"
ONIX_REGISTRY_URL="http://api.testnet.beckn.one/dedi"
ONIX_REGISTRY_NAME="subscribers.beckn.one"

